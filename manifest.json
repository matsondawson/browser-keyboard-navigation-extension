{
  "manifest_version": 3,
  "name": "Browser Keyboard Navigation",
  "version": "0.1.0",
  "description": "Search for links, buttons and inputs by their text, then activate them with a number key.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["index.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-keyboard-navigation@matsondawson",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
